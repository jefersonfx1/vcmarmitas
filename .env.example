# Supabase (em breve)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas
# Pegue a chave em: https://sandbox.asaas.com (Sandbox) ou https://www.asaas.com (Produção)
# Sandbox: chave começa com $aact_hmlg_
# Produção: chave começa com $aact_prod_
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# URL do site (importante para os retornos do Asaas)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
